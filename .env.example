# Copy to .env for local development. Never commit real secrets.
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Core ---
APP_NAME="TeamFlow API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (async URL for the API; sync URL for Celery workers) ---
DATABASE_URL=postgresql+asyncpg://teamflow:teamflow@localhost:5432/teamflow
DATABASE_URL_SYNC=postgresql+psycopg://teamflow:teamflow@localhost:5432/teamflow

# Compose Postgres credentials (used by the `db` service and containerized API).
# Override with strong values in production.
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=teamflow
POSTGRES_DB=teamflow

# --- Security / JWT ---
# dev-secret-change-me-in-production
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Redis (rate limiting, token store, WS pub/sub, dashboard cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=60

# --- Object storage (MinIO in development) ---
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=teamflow
S3_SECRET_KEY=teamflow-secret
S3_BUCKET=teamflow-attachments
S3_SECURE=false

# --- Email ---
EMAIL_BACKEND=console
EMAIL_FROM=teamflow@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
FRONTEND_BASE_URL=http://localhost:3000
# Set false on hosts with a system proxy that cannot reach receiver URLs.
WEBHOOK_HTTPX_TRUST_ENV=true

# --- Admin panel (superuser-only; log in at /admin with email + password) ---
ADMIN_ENABLED=true
ADMIN_BASE_URL=/admin
ADMIN_TITLE="TeamFlow Admin"
ADMIN_SESSION_MAX_AGE_SECONDS=28800
