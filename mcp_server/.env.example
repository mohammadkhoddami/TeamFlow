# TeamFlow MCP server configuration.
# Copy to `.env` next to the server (or set these in your agent's MCP config).
# `.env` is gitignored; never commit real credentials.

# Base URL of the TeamFlow API. The `/api/v1` suffix is added automatically
# if you omit it, so both of these work:
#   TEAMFLOW_API_URL=http://localhost:8000
#   TEAMFLOW_API_URL=https://teamflow.example.com
TEAMFLOW_API_URL=http://localhost:8000

# Account the agent acts as. Needs a password of at least 10 characters.
TEAMFLOW_EMAIL=you@example.com
TEAMFLOW_PASSWORD=change-me-please

# Optional defaults so tool calls can omit org/project.
# TEAMFLOW_ORG=my-org
# TEAMFLOW_PROJECT=My Board

# Optional tuning.
# TEAMFLOW_TIMEOUT=30
# TEAMFLOW_VERIFY_SSL=true
