# TeamFlow MCP server - reference for the variables it reads.
#
# This file is a TEMPLATE, not a config file. teamflow-mcp does NOT read it.
#
# Where real values come from, in increasing precedence:
#   1. ~/.config/teamflow/.env      shared personal defaults (e.g. the API URL)
#   2. <project>/.env               the workspace the server was launched in
#   3. process environment          always wins (e.g. an agent's "environment" block)
#
# So the normal setup is: put the API URL once in the shared file, and the
# identity (TEAMFLOW_EMAIL / TEAMFLOW_PASSWORD) in each project's own .env.
# Never commit a .env that holds a password - the repo .gitignore covers
# `.env` and `.env.*`.

# --- API location -----------------------------------------------------------
# Base URL only; /api/v1 is appended automatically if you omit it.
# Set this once in ~/.config/teamflow/.env to share it across every project.
TEAMFLOW_API_URL=http://localhost:8000
# TEAMFLOW_API_URL=https://arsene.ir/flow

# --- Identity (per project) -------------------------------------------------
# The account the agent acts as. Use a real, personal account: task
# attribution, audit logs and notifications all key off it.
TEAMFLOW_EMAIL=you@example.com
TEAMFLOW_PASSWORD=change-me-please

# --- Optional defaults ------------------------------------------------------
# Organization slug (the last part of https://<host>/org/<slug>). Needed only
# when the account belongs to more than one organization.
# TEAMFLOW_ORG=my-org

# Default project name or UUID, so tool calls can omit the project.
# TEAMFLOW_PROJECT=My Board

# --- Optional tuning --------------------------------------------------------
# TEAMFLOW_TIMEOUT=30
# TEAMFLOW_VERIFY_SSL=true

# Honour HTTP(S)_PROXY / system proxy settings. Set false when the proxy cannot
# reach the API - typical when TeamFlow runs on localhost on a machine that has
# a system proxy configured (mirrors the API's webhook_httpx_trust_env).
# TEAMFLOW_TRUST_ENV=false

# Pin the project env file explicitly instead of discovering it from the
# working directory:
# TEAMFLOW_ENV_FILE=/absolute/path/to/.env

# --- Remote HTTP deployment -------------------------------------------------
# Default is stdio (the agent spawns this process). Set streamable-http to run
# one shared server on a VPS; callers then send their own personal access token
# as `Authorization: Bearer tf_...` on every request.
# TEAMFLOW_MCP_TRANSPORT=streamable-http
# TEAMFLOW_MCP_HOST=0.0.0.0
# TEAMFLOW_MCP_PORT=8765
# TEAMFLOW_MCP_PATH=/mcp
# TEAMFLOW_MCP_STATELESS=true
# TEAMFLOW_MCP_JSON_RESPONSE=true

# Optional fallback identity for remote callers that cannot send a bearer
# token. Leave unset to require a token per request.
# TEAMFLOW_TOKEN=tf_...
