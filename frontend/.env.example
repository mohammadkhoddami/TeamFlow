# API base URL (FastAPI, see backend README). Defaults to localhost:8000.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket base URL. Defaults to the API host with ws:// and no /api/v1 path.
VITE_WS_BASE_URL=ws://localhost:8000

# Public VAPID key for web push (generate with `npx web-push generate-vapid-keys`).
# Push stays disabled in the UI when this is empty.
VITE_VAPID_PUBLIC_KEY=
